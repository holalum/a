# Get from https://my.telegram.org/apps
API_ID=1234567
API_HASH=abcdef0123456789abcdef0123456789

# Create a bot via @BotFather, paste its token here.
# This bot will deliver notifications to you in DM.
BOT_TOKEN=123456:ABC-DEF...

# Your numeric Telegram user id (get via @userinfobot).
# Notifications will be sent to this user by the bot above.
NOTIFY_USER_ID=123456789

# How many days to keep cached messages (for resolving deletions).
RETENTION_DAYS=7
