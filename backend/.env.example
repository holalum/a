# ============================================================
#  Harmony VPN — конфигурация бэкенда
#  Скопируй этот файл в backend/.env и заполни значения.
#    cp backend/.env.example backend/.env
#  Файл .env в git НЕ попадает (см. .gitignore).
# ============================================================

# --- Окружение ---
# dev — подробные логи и автоперезагрузка; prod — боевой режим
ENVIRONMENT=dev

# --- HTTP-сервер ---
APP_HOST=0.0.0.0
APP_PORT=8000
# Домены фронтенда, которым разрешён доступ (CORS), через запятую.
# Укажи адрес, на котором открывается мини-апп.
CORS_ORIGINS=https://your-miniapp-domain.com

# --- Telegram ---
# Токен бота от @BotFather. Используется для ПРОВЕРКИ подписи initData —
# именно так бэкенд убеждается, что запрос пришёл от реального юзера Telegram.
BOT_TOKEN=0000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Username бота без @ — нужен для генерации реферальных ссылок.
BOT_USERNAME=HarmonyVPNBot

# --- Remnawave ---
# Базовый URL панели (без слэша на конце), например https://panel.example.com
REMNAWAVE_BASE_URL=https://panel.your-domain.com
# API-токен/ключ доступа к Remnawave API.
# ВАЖНО: токен живёт только здесь, на бэкенде, и никогда не уходит на фронт.
REMNAWAVE_API_TOKEN=
# Если панель за Cloudflare с защитой — доп. заголовки (иначе оставь пустыми).
REMNAWAVE_CF_ACCESS_CLIENT_ID=
REMNAWAVE_CF_ACCESS_CLIENT_SECRET=

# --- База данных (PostgreSQL) ---
# Формат: postgresql+asyncpg://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БД
DATABASE_URL=postgresql+asyncpg://harmony:CHANGE_ME@localhost:5432/harmony

# --- Безопасность ---
# Секрет для подписи сессионных JWT (выдаём фронту после проверки initData).
# Сгенерируй: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_RANDOM_64_HEX
# Сколько часов живёт сессионный токен фронтенда
SESSION_TTL_HOURS=24

# --- Бизнес-логика ---
# Реферальная комиссия по умолчанию, %
REFERRAL_COMMISSION_PERCENT=20
# Кулдаун колеса фортуны, дней
WHEEL_COOLDOWN_DAYS=7
# Валюта баланса
CURRENCY=RUB

# --- Платежи (заполнишь, когда подключим приём оплаты) ---
# Оставь пустыми пока — пополнение баланса будет заглушкой.
PAYMENT_PROVIDER=
PAYMENT_TOKEN=
